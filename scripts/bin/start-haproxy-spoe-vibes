#!/bin/sh

# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.

set -xe

PORT=$(snapctl get server.port)

if [ -z "$PORT" ]; then
  PORT=25159
fi

export OPENAI_API_KEY=$(snapctl get api-key)
export OPENAI_API_URL=$(snapctl get api-url)
export OPENAI_MODEL=$(snapctl get model)

exec $SNAP/bin/vibes $PORT