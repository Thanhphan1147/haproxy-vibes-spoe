#!/bin/sh

# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.

set -xe

export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$SNAP/usr/local/lib
PORT=$(snapctl get server.port)

if [ -z "$PORT" ]; then
  PORT=11434
fi
exec $SNAP/usr/local/bin/llama-server -m $SNAP/models/model.gguf --host 127.0.0.1 --port $PORT \
  --temp 0.7 --top-k 20 --top-p 0.8 --min-p 0 --presence-penalty 1.5 \
  --no-context-shift
  --capture-output --log-level="$LOG_LEVEL"